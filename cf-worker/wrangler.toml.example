# wrangler.toml.example — vt-passkey v2 TypeScript Worker
#
# Copy this file to `wrangler.toml` and fill in your own values.
# The real `wrangler.toml` is gitignored (it carries account/Access ids).
#
#   cp cf-worker/wrangler.toml.example cf-worker/wrangler.toml

name = "vt-passkey"
main = "src/index.ts"
compatibility_date = "2025-01-01"
compatibility_flags = ["nodejs_compat"]
# Your Cloudflare account id (Dashboard → Workers → Account details).
account_id = "<YOUR_CLOUDFLARE_ACCOUNT_ID>"

# Only serve from the custom domain (via Route). Disable the default
# *.workers.dev hostname and per-deploy preview URLs.
workers_dev = false
preview_urls = false

# Declare the custom domain HERE, even though you attached it in the dashboard.
# `wrangler deploy` treats this file as the source of truth and warns
# "Uploading the Worker will override the remote configuration with your local
# one" when it sees a route remotely that is missing locally — a deploy from a
# config without this block is one step away from detaching the hostname that
# serves every approval URL. Declaring it makes the warning (and the risk) go away.
[[routes]]
pattern = "<your-worker-hostname, e.g. vt.example.com>"
custom_domain = true

# Workers Logs: persist structured audit events (challenge.created /
# approved / rejected / expired / error) for dashboard viewing. Retention
# is platform-managed (currently 3 days on Free, 7 days on Paid). Log volume
# is kept minimal — see src/log.ts and audit call sites.
[observability]
enabled = true
head_sampling_rate = 1.0

[assets]
directory = "pwa"
# Static PWA assets (CSS, JS, libsodium.js) and the two HTML page shells are
# reached only via ASSETS.fetch() from the worker: the public /pwa/* route
# (pwa/admin/* included — a shell on disk is markup plus a {{VT_DATA}} slot,
# data is rendered in only by the Access-gated /<ADMIN_SEG> route) and the
# root-scope /sw.js + /manifest.webmanifest that Web Push needs.
# run_worker_first disables Cloudflare's default static-first routing so every
# request hits the worker. Leave html_handling at its default; src/index.ts
# reads a shell by both its extensionless and its .html path, so either
# setting works.
# pwa/libsodium.js is vendored/committed (ISC); see pwa/libsodium.README to refresh it.
binding = "ASSETS"
run_worker_first = true

[[durable_objects.bindings]]
name = "ACCOUNT"
class_name = "AccountDO"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["AccountDO"]

# Per-IP throttle on POST /api/enroll — the ONE unauthenticated route that can
# page the operator's phone (a host asking for its own VT_PASSKEY_TOKEN; see
# docs/host-token.md). Without this binding the Worker refuses enrollment (503)
# rather than run it unthrottled. `namespace_id` is any integer unique among the
# rate limits in this account. 3 attempts / minute / IP is plenty for a human.
[[unsafe.bindings]]
name = "ENROLL_LIMITER"
type = "ratelimit"
namespace_id = "1001"
simple = { limit = 3, period = 60 }

[vars]
# Public origin / RP id for WebAuthn. Use your own domain.
WORKER_ORIGIN = "https://vt.example.com"
RP_ID = "vt.example.com"
# WebAuthn user-verification policy for APPROVAL ceremonies (approve + reject).
# Registration is unaffected — enrolling a passkey always requires verification.
#
# Empty/absent → the built-in default: `discouraged`, so approving is ONE click in
# the platform/1Password prompt instead of a click plus a second biometric step.
# User presence (the tap) is still mandatory and still verified server-side, and
# the approve URL remains an unguessable 96-bit token with a 5-minute life.
#
# Raise it wherever you want the biometric step back — every rule and the client's
# `vt --uv` request can only RAISE the level, never lower it:
#
#   APPROVAL_UV_JSON = '{"default":"discouraged","by_op":{"decrypt":"required"},"by_host":{"prod-db":"required"}}'
#
# `by_op` keys are op kinds (decrypt / encrypt / auth / cache-extend / …); `by_host`
# keys are the client-reported hostname (advisory — it may only raise). Levels are
# `discouraged` | `preferred` | `required`. A malformed value falls back to
# `required` everywhere, so a typo costs a prompt, never a weaker ceremony. The
# admin cache-extension ceremony is pinned to `required` and ignores any attempt
# here to lower it. See src/uv_policy.ts.
APPROVAL_UV_JSON = ""
# Cloudflare Access (Zero Trust) gates the /<ADMIN_SEG>/* surface (ADMIN_SEG is
# a constant in src/index.ts). Fill these in after creating the Access
# Application whose Path equals ADMIN_SEG (e.g. <origin>/kestrel):
#   ACCESS_TEAM_DOMAIN  your "<team>.cloudflareaccess.com" (no scheme)
#   ACCESS_AUD          the Access Application's AUD tag
# Both empty → the Worker fails closed (403) on every admin-surface request.
ACCESS_TEAM_DOMAIN = "<your-team>.cloudflareaccess.com"
ACCESS_AUD = "<YOUR_ACCESS_APPLICATION_AUD_TAG>"
# Cache-hit (免审批) Web Push notices. Off unless set to 1/true/on/yes — they
# fire on every DEK-cache and agent Touch-ID-cache hit and bury the approval
# messages that need a tap. Audit rows are written either way, so cache hits
# stay visible on the admin audit page.
CACHE_HIT_NOTIFY = "0"
# Admin-requested DEK-cache extension (the「延长」buttons on the admin DEK 缓存
# tab). Off unless set to 1/true/on/yes. A KILL SWITCH, not an authorization: even
# when on, extending requires a fresh phone Passkey approval and may only request a
# laddered TTL — 20m / 2h / 8h / 1d / 2d / 1w / 100 years (that last rung is
# permanent in practice). Extension is measured from the approval (expiry becomes
# "now + chosen TTL"), never additive, and can never revive an entry that already
# lapsed.
#
# READ THIS BEFORE ENABLING. There is NO total-lifetime ceiling: an entry can be
# renewed indefinitely, one approval at a time, and the permanent rung means an
# entry need never expire at all. For as long as a window is open, possession of
# VT_PASSKEY_TOKEN from the same egress IP and `pwd` decrypts those records with no
# phone tap. What bounds this is liveness (a lapsed cache is gone for good) and the
# fact that every hop costs a Passkey approval — not a time budget. To revoke:
# 清除 on the tab, or rotate CACHE_SECKEY. Trim EXTEND_TTL_WHITELIST in
# src/cache_policy.ts to remove rungs you do not want reachable, and consider
# CACHE_HIT_NOTIFY=1 so no-tap decrypts stay visible.
#
# Set it HERE, not in the Cloudflare dashboard: `wrangler deploy` replaces the
# Worker's vars with this file's [vars] block, so a dashboard-only value is
# silently wiped on the next deploy and the feature turns itself off.
CACHE_ADMIN_EXTEND = "0"

# Secrets (wrangler secret put — never inlined):
#   VT_AUTH_CF        32-byte base64url master. Per-host VT_PASSKEY_TOKENs are
#                     HKDF-derived from it at enrollment (docs/host-token.md), so
#                     rotating it invalidates every token: re-enroll each host the
#                     same day. NEVER hand it to a host.
#   CREDENTIALS_JSON  JSON blob with passkey credentials (schema in src/credentials.ts)
#   CACHE_SECKEY      32-byte base64url X25519 secret key enabling the opt-in DEK
#                     cache (approve-time TTL → 免审批解密 within IP+pwd scope).
#                     Generate: `openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'`.
#                     Empty/absent → caching disabled (every decrypt needs phone).
#                     Rotate to instantly invalidate all cached DEKs. NEVER inline.
# Notifications need no secret: phones subscribe to Web Push on the admin 推送
# tab, and the VAPID key pair lives encrypted in the Durable Object
# (docs/worker-slim.md §5). Upgrading from the channel builds:
#   wrangler secret delete PUSHOVER_JSON SLACK_APP_JSON FEISHU_JSON
