# wrangler.toml.example — vt-passkey v2 TypeScript Worker
#
# Copy this file to `wrangler.toml` and fill in your own values.
# The real `wrangler.toml` is gitignored (it carries your account id).
#
#   cp cf-worker/wrangler.toml.example cf-worker/wrangler.toml

name = "vt-passkey"
main = "src/index.ts"
compatibility_date = "2025-01-01"
compatibility_flags = ["nodejs_compat"]
# Your Cloudflare account id (Dashboard → Workers → Account details).
account_id = "<YOUR_CLOUDFLARE_ACCOUNT_ID>"

# Only serve from the custom domain (via Route). Disable the default
# *.workers.dev hostname and per-deploy preview URLs.
workers_dev = false
preview_urls = false

# Declare the custom domain HERE, even though you attached it in the dashboard.
# `wrangler deploy` treats this file as the source of truth and warns
# "Uploading the Worker will override the remote configuration with your local
# one" when it sees a route remotely that is missing locally — a deploy from a
# config without this block is one step away from detaching the hostname that
# serves every approval URL. Declaring it makes the warning (and the risk) go away.
[[routes]]
pattern = "<your-worker-hostname, e.g. vt.example.com>"
custom_domain = true

# Workers Logs: persist structured audit events (challenge.created /
# approved / rejected / expired / error) for dashboard viewing. Retention
# is platform-managed (currently 3 days on Free, 7 days on Paid). Log volume
# is kept minimal — see src/log.ts and audit call sites.
[observability]
enabled = true
head_sampling_rate = 1.0

[assets]
directory = "pwa"
# Static PWA assets (CSS, JS, libsodium.js) and the two HTML page shells are
# reached only via ASSETS.fetch() from the worker: the public /pwa/* route
# (pwa/admin/* included — a shell on disk is markup plus a {{VT_DATA}} slot,
# data is rendered in only by the /admin route for this request's session) and the
# root-scope /sw.js + /manifest.webmanifest that Web Push needs.
# run_worker_first disables Cloudflare's default static-first routing so every
# request hits the worker. Leave html_handling at its default; src/index.ts
# reads a shell by both its extensionless and its .html path, so either
# setting works.
# pwa/libsodium.js is vendored/committed (ISC); see pwa/libsodium.README to refresh it.
binding = "ASSETS"
run_worker_first = true

[[durable_objects.bindings]]
name = "ACCOUNT"
class_name = "AccountDO"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["AccountDO"]

# Per-IP throttle on the unauthenticated POSTs: /api/enroll (a host asking for
# its own VT_PASSKEY_TOKEN, which pages the phone; docs/host-token.md) and the
# admin bootstrap / login-challenge routes (docs/worker-slim.md §3). Without
# this binding the Worker refuses them (503) rather than run them unthrottled.
# `namespace_id` is any integer unique among the rate limits in this account.
# 3 attempts / minute / IP is plenty for a human.
[[unsafe.bindings]]
name = "LIMITER"
type = "ratelimit"
namespace_id = "1001"
simple = { limit = 3, period = 60 }

# No [vars]. Everything the operator can set — caching, cache-hit pushes, the
# approval UV policy, push subscriptions — lives encrypted in the Durable
# Object and is edited on the admin 设置 tab; the WebAuthn origin is captured
# at bootstrap (docs/worker-slim.md §4).
#
# The one secret (wrangler secret put — never inlined):
#   SECRET   32 random bytes, base64url:
#              openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n' | wrangler secret put SECRET
#            A KEK over the root key stored in the Durable Object; host tokens,
#            admin sessions, the config blob and the DEK-cache key all derive
#            from that root key, so this value alone opens nothing. Rotate it
#            from the 设置 tab (轮换 SECRET), which keeps everything; setting a
#            fresh value WITHOUT rotating is the factory reset
#            (docs/cf-worker-deploy.md).
# Upgrading from the VT_AUTH_CF / CREDENTIALS_JSON / CACHE_SECKEY build:
#   wrangler secret delete VT_AUTH_CF CREDENTIALS_JSON CACHE_SECKEY
