# wrangler.toml.example — vt-passkey v2 TypeScript Worker
#
# Copy this file to `wrangler.toml` and fill in your own values.
# The real `wrangler.toml` is gitignored (it carries account/Access ids).
#
#   cp cf-worker/wrangler.toml.example cf-worker/wrangler.toml

name = "vt-passkey"
main = "src/index.ts"
compatibility_date = "2025-01-01"
compatibility_flags = ["nodejs_compat"]
# Your Cloudflare account id (Dashboard → Workers → Account details).
account_id = "<YOUR_CLOUDFLARE_ACCOUNT_ID>"

# Only serve from the custom domain (via Route). Disable the default
# *.workers.dev hostname and per-deploy preview URLs.
workers_dev = false
preview_urls = false

# Workers Logs: persist structured audit events (challenge.created /
# approved / rejected / expired / error) for dashboard viewing. Retention
# is platform-managed (currently 3 days on Free, 7 days on Paid). Log volume
# is kept minimal — see src/log.ts and audit call sites.
[observability]
enabled = true
head_sampling_rate = 1.0

[assets]
directory = "pwa"
# Static PWA assets (CSS, JS, libsodium.js) are reached only via
# ASSETS.fetch() from the worker at /pwa/* and /<ADMIN_SEG>/pwa/*.
# run_worker_first disables Cloudflare's default static-first routing so all
# requests hit the worker (admin assets stay behind Cloudflare Access).
# pwa/libsodium.js is vendored/committed (ISC); see pwa/libsodium.README to refresh it.
binding = "ASSETS"
run_worker_first = true

[[durable_objects.bindings]]
name = "ACCOUNT"
class_name = "AccountDO"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["AccountDO"]

[vars]
# Public origin / RP id for WebAuthn. Use your own domain.
WORKER_ORIGIN = "https://vt.example.com"
RP_ID = "vt.example.com"
# Cloudflare Access (Zero Trust) gates the /<ADMIN_SEG>/* surface (ADMIN_SEG is
# a constant in src/index.ts). Fill these in after creating the Access
# Application whose Path equals ADMIN_SEG (e.g. <origin>/kestrel):
#   ACCESS_TEAM_DOMAIN  your "<team>.cloudflareaccess.com" (no scheme)
#   ACCESS_AUD          the Access Application's AUD tag
# Both empty → the Worker fails closed (403) on every admin-surface request.
ACCESS_TEAM_DOMAIN = "<your-team>.cloudflareaccess.com"
ACCESS_AUD = "<YOUR_ACCESS_APPLICATION_AUD_TAG>"
# Cache-hit (免审批) real-time notices. Off unless set to 1/true/on/yes — they
# fire on every DEK-cache and agent Touch-ID-cache hit and bury the approval
# messages that need a tap. Audit rows are written either way, so cache hits
# stay visible on the admin audit page.
CACHE_HIT_NOTIFY = "0"
# Admin-requested DEK-cache extension (the「延长」buttons on the admin DEK 缓存
# tab). Off unless set to 1/true/on/yes. This is a KILL SWITCH, not an
# authorization: even when on, extending requires a fresh phone Passkey approval,
# may only request a whitelisted TTL (20m/2h/8h), can never revive an entry that
# already lapsed, and can never push one past 8h from its creation. Off means the
# capability does not exist — the routes 404 and the UI hides the controls.
# Listing and clearing cached DEKs are unaffected (they only reduce authority).
CACHE_ADMIN_EXTEND = "0"

# Secrets (wrangler secret put — never inlined):
#   VT_AUTH_CF        32-byte base64url token, daemon→Worker HMAC on /api/challenge
#   CREDENTIALS_JSON  JSON blob with passkey credentials (schema in src/credentials.ts)
#   CACHE_SECKEY      32-byte base64url X25519 secret key enabling the opt-in DEK
#                     cache (approve-time TTL → 免审批解密 within IP+pwd scope).
#                     Generate: `openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'`.
#                     Empty/absent → caching disabled (every decrypt needs phone).
#                     Rotate to instantly invalidate all cached DEKs. NEVER inline.
#   PUSHOVER_JSON     {"app_token":"…","user_key":"…"}  — optional Pushover channel
#   SLACK_JSON        {"webhook_url":"https://hooks.slack.com/services/…"} — optional Slack (webhook, one-way) channel
#   SLACK_APP_JSON    {"bot_token":"xoxb-…","channel":"C…","mention"?:["U…"]}
#                     — optional Slack App channel (bot token): @-mentions approvers
#                     + edits the message in place on the decision. See docs/slack-app.md.
#   FEISHU_JSON       {"app_id","app_secret","receive_id","receive_id_type"?,"mention"?,"base"?}
#                     — optional 飞书/Lark channel (self-built app bot): @-mentions
#                     approvers + edits the card in place on the decision. See docs/feishu.md.
# All notification secrets are independent and opt-in; generate them on the
# admin "推送渠道" tab. Empty/absent → that channel is simply disabled.
